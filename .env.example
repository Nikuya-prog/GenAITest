# Salesforce connection used only by the Python backend.
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_DOMAIN=login

# Gemini key used for risk analysis and task suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Initial setup secret: replace with a long random value before first startup.
DEALWATCH_SETUP_SECRET=replace-with-a-long-random-secret

# Set this to the team's IANA timezone before enabling scheduled scans.
TEAM_TIMEZONE=Asia/Manila
ENABLE_SCHEDULER=true
DATABASE_URL=sqlite:///./dealwatch.sqlite3
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Use shared Redis storage for rate limits when running multiple API instances.
RATE_LIMIT_STORAGE_URI=memory://
ALERT_EMAIL_FROM=
